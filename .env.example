# ─────────────────────────────────────────
# App
# ─────────────────────────────────────────
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# ─────────────────────────────────────────
# Database (matches docker-compose.yml)
# ─────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=node_starter
POSTGRES_PORT=5432

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/node_starter?schema=public"

# ─────────────────────────────────────────
# Auth — use long, random, unique secrets (min 16 chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ─────────────────────────────────────────
ACCESS_TOKEN_SECRET=change-me-to-a-long-random-secret-min-16-chars
REFRESH_TOKEN_SECRET=change-me-to-another-different-random-secret-min-16
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# ─────────────────────────────────────────
# CORS — comma-separated list of allowed origins
# ─────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ─────────────────────────────────────────
# Adminer
# ─────────────────────────────────────────
ADMINER_PORT=8080
