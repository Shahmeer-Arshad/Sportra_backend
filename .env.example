# ─────────────────────────────────────────
# App
# ─────────────────────────────────────────
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# ─────────────────────────────────────────
# Database (matches docker-compose.yml)
# ─────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=node_starter
POSTGRES_PORT=5432

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/node_starter?schema=public"

# ─────────────────────────────────────────
# Auth — use long, random, unique secrets (min 16 chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ─────────────────────────────────────────
ACCESS_TOKEN_SECRET=change-me-to-a-long-random-secret-min-16-chars
REFRESH_TOKEN_SECRET=change-me-to-another-different-random-secret-min-16
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# ─────────────────────────────────────────
# CORS — comma-separated list of allowed origins
# ─────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ─────────────────────────────────────────
# Adminer
# ─────────────────────────────────────────
ADMINER_PORT=8080

# ─────────────────────────────────────────
# Infra (docker compose up -d). Optional for the API, required for the worker.
# ─────────────────────────────────────────
REDIS_URL=redis://localhost:56379
RABBITMQ_URL=amqp://guest:guest@localhost:55672
OUTBOX_POLL_MS=500
OUTBOX_BATCH=100

# ─────────────────────────────────────────
# Identity: OTP codes are stored as HMAC(code, this secret). Min 16 chars, keep secret.
# ─────────────────────────────────────────
OTP_HMAC_SECRET=change-me-otp-secret-0123456789
REFRESH_TOKEN_DAYS=30
SMTP_HOST=localhost
SMTP_PORT=51025
# Real provider only (Gmail: smtp.gmail.com, port 587, your address + App Password). Empty = no login (MailHog).
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Sportra <no-reply@sportra.local>"
# Seed admin (npm run db:seed)
ADMIN_SEED_EMAIL=admin@sportra.local
ADMIN_SEED_PASSWORD=Admin@12345
BCRYPT_COST=12

# ─────────────────────────────────────────
# Booking (Phase 2)
# ─────────────────────────────────────────
HOLD_SECONDS=300
SLOT_HORIZON_DAYS=60
MAX_PENDING_HOLDS=2
MAX_UNPAID_BOOKINGS=1
NO_SHOW_AFTER_MINUTES=20
SWEEP_INTERVAL_SECONDS=60
# Signs QR entry passes (min 16 chars). Optional: derived from ACCESS_TOKEN_SECRET when unset.
# QR_PASS_SECRET=change-me-qr-pass-secret-0123456789
