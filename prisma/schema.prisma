// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────
// Identity module (Phase 1)
// Enums are text + CHECK constraints (see migration SQL). IDs are UUID v7 made by the app.
// ─────────────────────────────────────────
model User {
  id                       String    @id @db.Uuid
  email                    String    @unique // always stored lower-case
  emailVerifiedAt          DateTime? @map("email_verified_at") @db.Timestamptz
  passwordHash             String?   @map("password_hash")
  fullName                 String    @map("full_name")
  phone                    String?   @unique
  phoneVerifiedAt          DateTime? @map("phone_verified_at") @db.Timestamptz
  whatsappOptIn            Boolean   @default(false) @map("whatsapp_opt_in")
  whatsappOptInAt          DateTime? @map("whatsapp_opt_in_at") @db.Timestamptz
  whatsappOptInSource      String?   @map("whatsapp_opt_in_source")
  whatsappOptInTextVersion String?   @map("whatsapp_opt_in_text_version")
  whatsappOptOutAt         DateTime? @map("whatsapp_opt_out_at") @db.Timestamptz
  platformRole             String    @default("USER") @map("platform_role")
  status                   String    @default("PENDING_VERIFICATION")
  signupIntent             String    @default("PLAYER") @map("signup_intent")
  noShowCount              Int       @default(0) @map("no_show_count")
  failedLoginCount         Int       @default(0) @map("failed_login_count")
  lockedUntil              DateTime? @map("locked_until") @db.Timestamptz
  lastLoginAt              DateTime? @map("last_login_at") @db.Timestamptz
  tokenValidAfter          DateTime  @default(now()) @map("token_valid_after") @db.Timestamptz
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  memberships   VenueMembership[]
  otpChallenges OtpChallenge[]
  refreshTokens RefreshToken[]
  consents      WhatsappConsent[]

  @@map("users")
}

model VenueMembership {
  id        String   @id @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id])
  venueId   String   @map("venue_id") @db.Uuid // plain id: the venue module owns venues
  role      String // OWNER | MANAGER | FRONT_DESK | SCORER
  isActive  Boolean  @default(true) @map("is_active")
  invitedBy String?  @map("invited_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([userId, venueId])
  @@index([venueId])
  @@map("venue_memberships")
}

model OtpChallenge {
  id          String    @id @db.Uuid
  userId      String?   @map("user_id") @db.Uuid
  user        User?     @relation(fields: [userId], references: [id])
  email       String
  purpose     String // SIGNUP_VERIFY | LOGIN_STEP_UP | LOGIN_PASSWORDLESS | PASSWORD_RESET | EMAIL_CHANGE | STAFF_INVITE
  codeHash    String    @map("code_hash")
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz
  attempts    Int       @default(0)
  maxAttempts Int       @default(5) @map("max_attempts")
  consumedAt  DateTime? @map("consumed_at") @db.Timestamptz
  requestIp   String?   @map("request_ip")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([email, purpose, createdAt(sort: Desc)], map: "otp_lookup")
  @@map("otp_challenges")
}

model RefreshToken {
  id         String    @id @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  user       User      @relation(fields: [userId], references: [id])
  familyId   String    @map("family_id") @db.Uuid // rotation family: reuse of an old token revokes the family
  tokenHash  String    @unique @map("token_hash")
  userAgent  String?   @map("user_agent")
  ip         String?
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz
  replacedBy String?   @map("replaced_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model WhatsappConsent {
  id                 String   @id @db.Uuid
  userId             String   @map("user_id") @db.Uuid
  user               User     @relation(fields: [userId], references: [id])
  phoneE164          String   @map("phone_e164")
  action             String // OPT_IN | OPT_OUT
  source             String
  consentTextVersion String?  @map("consent_text_version")
  ip                 String?
  userAgent          String?  @map("user_agent")
  occurredAt         DateTime @default(now()) @map("occurred_at") @db.Timestamptz

  @@index([userId, occurredAt(sort: Desc)])
  @@map("whatsapp_consents")
}

model StaffInvitation {
  id         String    @id @db.Uuid
  venueId    String    @map("venue_id") @db.Uuid
  email      String
  role       String // MANAGER | FRONT_DESK | SCORER
  tokenHash  String    @unique @map("token_hash")
  invitedBy  String    @map("invited_by") @db.Uuid
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@map("staff_invitations")
}

// ─────────────────────────────────────────
// Venue module (Phase 1)
// The geography column, GiST/trigram indexes and CHECKs live in the migration SQL.
// ─────────────────────────────────────────
model Area {
  id      String   @id @db.Uuid
  city    String
  name    String
  slug    String
  aliases String[] @default([])
  lat     Float?
  lng     Float?
  venues  Venue[]

  @@unique([city, slug])
  @@map("areas")
}

model Venue {
  id                      String                                @id @db.Uuid
  ownerUserId             String                                @map("owner_user_id") @db.Uuid
  name                    String
  slug                    String                                @unique
  city                    String
  areaId                  String?                               @map("area_id") @db.Uuid
  area                    Area?                                 @relation(fields: [areaId], references: [id])
  address                 String
  lat                     Float
  lng                     Float
  // Generated from lat/lng in the migration. Never written by the app; read with raw SQL.
  location                Unsupported("geography(Point,4326)")?
  amenities               String[]                              @default([])
  whatsappNumber          String?                               @map("whatsapp_number")
  contactPhone            String?                               @map("contact_phone")
  contactEmail            String?                               @map("contact_email")
  timezone                String                                @default("Asia/Karachi")
  operatingHours          Json                                  @map("operating_hours") @db.JsonB
  cancellationCutoffHours Int                                   @default(12) @map("cancellation_cutoff_hours")
  commissionBps           Int                                   @default(0) @map("commission_bps")
  verificationStatus      String                                @default("DRAFT") @map("verification_status")
  isActive                Boolean                               @default(true) @map("is_active")
  photos                  String[]                              @default([])
  onboardingStep          Int                                   @default(1) @map("onboarding_step")
  submittedAt             DateTime?                             @map("submitted_at") @db.Timestamptz
  verifiedAt              DateTime?                             @map("verified_at") @db.Timestamptz
  verifiedBy              String?                               @map("verified_by") @db.Uuid
  version                 Int                                   @default(1)
  createdAt               DateTime                              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime                              @updatedAt @map("updated_at") @db.Timestamptz

  courts  Court[]
  reviews VenueReview[]

  @@index([city, areaId])
  @@index([location], type: Gist, map: "venues_location_gix")
  @@index([amenities], type: Gin, map: "venues_amenities_gin")
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "venues_name_trgm")
  @@map("venues")
}

model Court {
  id            String        @id @db.Uuid
  venueId       String        @map("venue_id") @db.Uuid
  venue         Venue         @relation(fields: [venueId], references: [id])
  name          String
  sport         String
  surface       String
  capacity      Int?
  slotMinutes   Int           @default(60) @map("slot_minutes")
  hoursOverride Json?         @map("hours_override") @db.JsonB
  isActive      Boolean       @default(true) @map("is_active")
  version       Int           @default(1)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  pricingRules  PricingRule[]

  @@index([venueId])
  @@index([sport, surface])
  @@map("courts")
}

model PricingRule {
  id         String   @id @db.Uuid
  courtId    String   @map("court_id") @db.Uuid
  court      Court    @relation(fields: [courtId], references: [id])
  name       String
  dayType    String   @map("day_type") // ANY | WEEKDAY | WEEKEND | DATE_RANGE
  startDate  String?  @map("start_date") // yyyy-mm-dd, for DATE_RANGE
  endDate    String?  @map("end_date")
  fromTime   String   @map("from_time") // HH:mm
  toTime     String   @map("to_time") // HH:mm, may be earlier than from_time (overnight)
  priceMinor BigInt   @map("price_minor")
  priority   Int      @default(0)
  tag        String // PEAK | OFF_PEAK
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([courtId, priority(sort: Desc)])
  @@map("pricing_rules")
}

model VenueReview {
  id           String   @id @db.Uuid
  venueId      String   @map("venue_id") @db.Uuid
  venue        Venue    @relation(fields: [venueId], references: [id])
  submissionNo Int      @map("submission_no")
  reviewerId   String   @map("reviewer_id") @db.Uuid
  decision     String // APPROVED | CHANGES_REQUESTED | REJECTED | SUSPENDED | REINSTATED
  comments     String?
  fieldFlags   Json     @default("[]") @map("field_flags") @db.JsonB
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([venueId, createdAt(sort: Desc)])
  @@map("venue_reviews")
}

// ─────────────────────────────────────────
// Platform tables (Phase 0): outbox / inbox / audit
// Partial indexes and the audit immutability trigger live in the migration SQL.
// ─────────────────────────────────────────
model Outbox {
  id          String    @id @db.Uuid
  eventType   String    @map("event_type")
  routingKey  String    @map("routing_key")
  payload     Json      @db.JsonB
  headers     Json      @default("{}") @db.JsonB
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  publishedAt DateTime? @map("published_at") @db.Timestamptz
  attempts    Int       @default(0)

  @@map("outbox")
}

model Inbox {
  eventId     String   @id @map("event_id") @db.Uuid
  consumer    String
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz

  @@map("inbox")
}

model AuditLog {
  id        BigInt   @id @default(autoincrement())
  actorId   String?  @map("actor_id") @db.Uuid
  actorType String?  @map("actor_type")
  venueId   String?  @map("venue_id") @db.Uuid
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  before    Json?    @db.JsonB
  after     Json?    @db.JsonB
  ip        String?
  requestId String?  @map("request_id")
  at        DateTime @default(now()) @db.Timestamptz

  @@map("audit_logs")
}

// ─────────────────────────────────────────
// Booking module (Phase 2)
// Exclusion constraints, partial indexes, the generated balance column and the SQL functions
// (cancel_booking_items, create_confirmed_items, uuid_v7) live in the migration SQL.
// Inventory paths use raw SQL; these models serve plain reads and test clean-up.
// ─────────────────────────────────────────
model Slot {
  id            String    @id @db.Uuid
  courtId       String    @map("court_id") @db.Uuid
  venueId       String    @map("venue_id") @db.Uuid
  startAt       DateTime  @map("start_at") @db.Timestamptz
  endAt         DateTime  @map("end_at") @db.Timestamptz
  businessDate  DateTime  @map("business_date") @db.Date
  priceMinor    BigInt    @map("price_minor")
  priceTag      String    @map("price_tag") // PEAK | OFF_PEAK
  status        String    @default("AVAILABLE") // AVAILABLE | HELD | BOOKED_APP | BOOKED_WALKIN | BLOCKED
  holdId        String?   @map("hold_id") @db.Uuid
  holdExpiresAt DateTime? @map("hold_expires_at") @db.Timestamptz
  bookingId     String?   @map("booking_id") @db.Uuid
  blockReason   String?   @map("block_reason")
  blockRef      String?   @map("block_ref") @db.Uuid
  blockNote     String?   @map("block_note")
  version       Int       @default(0)
  updatedAt     DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  items BookingItem[]

  @@unique([courtId, startAt], map: "slots_court_start_key")
  @@index([venueId, businessDate, courtId, startAt], map: "slots_grid")
  @@map("slots")
}

model Booking {
  id                      String    @id @db.Uuid
  ref                     String    @unique
  venueId                 String    @map("venue_id") @db.Uuid
  courtId                 String    @map("court_id") @db.Uuid
  userId                  String?   @map("user_id") @db.Uuid
  source                  String // APP | WALKIN | MANUAL | TOURNAMENT
  customerName            String    @map("customer_name")
  customerPhone           String    @map("customer_phone")
  customerEmail           String?   @map("customer_email")
  headcount               Int?
  status                  String
  paymentMode             String    @map("payment_mode")
  paymentStatus           String    @default("UNPAID") @map("payment_status")
  startAt                 DateTime  @map("start_at") @db.Timestamptz
  endAt                   DateTime  @map("end_at") @db.Timestamptz
  businessDate            DateTime  @map("business_date") @db.Date
  totalMinor              BigInt    @map("total_minor")
  originalTotalMinor      BigInt    @map("original_total_minor")
  depositMinor            BigInt    @default(0) @map("deposit_minor")
  onlinePaidMinor         BigInt    @default(0) @map("online_paid_minor")
  cashCollectedMinor      BigInt    @default(0) @map("cash_collected_minor")
  refundedMinor           BigInt    @default(0) @map("refunded_minor")
  forfeitedMinor          BigInt    @default(0) @map("forfeited_minor")
  refundPendingMinor      BigInt    @default(0) @map("refund_pending_minor")
  commissionMinor         BigInt    @default(0) @map("commission_minor")
  slotIds                 String[]  @default([]) @map("slot_ids") @db.Uuid
  holdId                  String?   @map("hold_id") @db.Uuid
  holdExpiresAt           DateTime? @map("hold_expires_at") @db.Timestamptz
  cancellationCutoffHours Int       @default(12) @map("cancellation_cutoff_hours") @db.SmallInt
  cancelledAt             DateTime? @map("cancelled_at") @db.Timestamptz
  cancelledBy             String?   @map("cancelled_by")
  cancelReason            String?   @map("cancel_reason")
  checkedInAt             DateTime? @map("checked_in_at") @db.Timestamptz
  noShowAt                DateTime? @map("no_show_at") @db.Timestamptz
  createdBy               String?   @map("created_by") @db.Uuid
  version                 Int       @default(0)
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  // Generated column (see migration). Read-only.
  balanceDueMinor         BigInt?   @default(dbgenerated()) @map("balance_due_minor")

  items         BookingItem[]
  cancellations BookingCancellation[]
  invites       Invite[]

  @@index([userId, startAt(sort: Desc)], map: "bookings_user")
  @@index([venueId, startAt, status], map: "bookings_venue")
  @@index([venueId, businessDate], map: "bookings_venue_day")
  @@map("bookings")
}

model BookingCancellation {
  id             String   @id @db.Uuid
  bookingId      String   @map("booking_id") @db.Uuid
  booking        Booking  @relation(fields: [bookingId], references: [id])
  cancelledBy    String   @map("cancelled_by")
  reason         String?
  actorId        String?  @map("actor_id") @db.Uuid
  refundDueMinor BigInt   @default(0) @map("refund_due_minor")
  forfeitMinor   BigInt   @default(0) @map("forfeit_minor")
  refundedMinor  BigInt   @default(0) @map("refunded_minor")
  result         Json     @db.JsonB
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  items BookingItem[]

  @@index([bookingId], map: "booking_cancellations_booking")
  @@map("booking_cancellations")
}

model BookingItem {
  id                String               @id @db.Uuid
  bookingId         String               @map("booking_id") @db.Uuid
  booking           Booking              @relation(fields: [bookingId], references: [id])
  slotId            String               @map("slot_id") @db.Uuid
  slot              Slot                 @relation(fields: [slotId], references: [id])
  courtId           String               @map("court_id") @db.Uuid
  venueId           String               @map("venue_id") @db.Uuid
  startAt           DateTime             @map("start_at") @db.Timestamptz
  endAt             DateTime             @map("end_at") @db.Timestamptz
  priceMinor        BigInt               @map("price_minor")
  onlinePaidMinor   BigInt               @default(0) @map("online_paid_minor")
  depositShareMinor BigInt               @default(0) @map("deposit_share_minor")
  status            String               @default("CONFIRMED") // CONFIRMED | CANCELLED | REFUNDED
  refundDueMinor    BigInt               @default(0) @map("refund_due_minor")
  forfeitMinor      BigInt               @default(0) @map("forfeit_minor")
  cancellationId    String?              @map("cancellation_id") @db.Uuid
  cancellation      BookingCancellation? @relation(fields: [cancellationId], references: [id])
  cancelledAt       DateTime?            @map("cancelled_at") @db.Timestamptz
  cancelledBy       String?              @map("cancelled_by")
  cancelReason      String?              @map("cancel_reason")
  version           Int                  @default(0)
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime             @default(now()) @map("updated_at") @db.Timestamptz

  @@index([bookingId, status], map: "booking_items_booking")
  @@index([venueId, startAt], map: "booking_items_venue_time")
  @@map("booking_items")
}

model IdempotencyKey {
  key         String
  scope       String
  requestHash String   @map("request_hash")
  response    Json?    @db.JsonB
  statusCode  Int?     @map("status_code")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@id([scope, key])
  @@index([createdAt], map: "idempotency_keys_created")
  @@map("idempotency_keys")
}

model Invite {
  id        String       @id @db.Uuid
  bookingId String       @map("booking_id") @db.Uuid
  booking   Booking      @relation(fields: [bookingId], references: [id])
  tokenHash String       @unique @map("token_hash")
  createdBy String       @map("created_by") @db.Uuid
  expiresAt DateTime     @map("expires_at") @db.Timestamptz
  revokedAt DateTime?    @map("revoked_at") @db.Timestamptz
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz
  rsvps     InviteRsvp[]

  @@index([bookingId], map: "invites_booking")
  @@map("invites")
}

model InviteRsvp {
  id        String   @id @db.Uuid
  inviteId  String   @map("invite_id") @db.Uuid
  invite    Invite   @relation(fields: [inviteId], references: [id])
  name      String
  phone     String?
  rsvpKey   String   @map("rsvp_key")
  status    String // GOING | NOT_GOING
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz

  @@unique([inviteId, rsvpKey], map: "invite_rsvps_unique")
  @@map("invite_rsvps")
}

model BookingSettings {
  venueId           String   @id @map("venue_id") @db.Uuid
  payAtVenueEnabled Boolean  @default(false) @map("pay_at_venue_enabled")
  updatedBy         String?  @map("updated_by") @db.Uuid
  updatedAt         DateTime @default(now()) @map("updated_at") @db.Timestamptz

  @@map("booking_settings")
}

model VenueBlocklist {
  venueId   String   @map("venue_id") @db.Uuid
  phone     String
  reason    String?
  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@id([venueId, phone])
  @@map("venue_blocklist")
}

model OutageLock {
  id            String    @id @db.Uuid
  venueId       String    @map("venue_id") @db.Uuid
  courtIds      String[]  @map("court_ids") @db.Uuid
  windowStart   DateTime  @map("window_start") @db.Timestamptz
  windowEnd     DateTime  @map("window_end") @db.Timestamptz
  reason        String
  note          String?
  status        String    @default("PROCESSING") // PROCESSING | ACTIVE | RELEASED
  totalBookings Int       @default(0) @map("total_bookings")
  processed     Int       @default(0)
  failed        Int       @default(0)
  manualToCall  Json      @default("[]") @map("manual_to_call") @db.JsonB
  createdBy     String    @map("created_by") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  releasedAt    DateTime? @map("released_at") @db.Timestamptz
  releasedBy    String?   @map("released_by") @db.Uuid

  @@index([venueId, createdAt(sort: Desc)], map: "outage_locks_venue")
  @@map("outage_locks")
}
