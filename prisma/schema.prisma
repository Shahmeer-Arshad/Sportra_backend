model VenueChangeRequest {
  id            String    @id @db.Uuid
  venueId       String    @map("venue_id") @db.Uuid
  venue         Venue     @relation(fields: [venueId], references: [id])
  op            String // court.add | court.update | rule.add | rule.delete | venue.update_hours
  params        Json      @default("{}") @db.JsonB
  payload       Json      @default("{}") @db.JsonB
  summary       String
  status        String    @default("PENDING") // PENDING | APPROVED | REJECTED | WITHDRAWN | FAILED
  requestedBy   String    @map("requested_by") @db.Uuid
  decidedBy     String?   @map("decided_by") @db.Uuid
  decisionNote  String?   @map("decision_note")
  failureReason String?   @map("failure_reason")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  decidedAt     DateTime? @map("decided_at") @db.Timestamptz

  @@index([status, createdAt], map: "venue_change_requests_status")
  @@index([venueId, status], map: "venue_change_requests_venue")
  @@map("venue_change_requests")
}
